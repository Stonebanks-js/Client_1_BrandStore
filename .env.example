# Google AI Studio key, used only by scripts/generate-catalog.mjs on your own machine.
# Copy this file to .env.local and paste your key in. .env.local is git-ignored.
# This key is NEVER read by the website, never bundled, and never sent to the browser.
GEMINI_API_KEY=

# Optional: pin a specific image model. Left blank, the script tries, in order,
# gemini-3-pro-image (Nano Banana Pro) -> gemini-3.1-flash-image -> gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=
